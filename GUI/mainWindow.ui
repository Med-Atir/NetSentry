  <property name="styleSheet">
   <string notr="true">/* === Base Window &amp; Containers === */
QMainWindow, QWidget#centralwidget {
    background-color: #0f172a;
    color: #e2e8f0;
    font-family: &quot;Inter&quot;, &quot;Segoe UI&quot;, sans-serif;
    font-size: 13px;
}

/* === Left Sidebar === */
QWidget#sidebar {
    background-color: #162032;
    border-right: 1px solid #1e293b;
}

QLabel#bar {
    color: #38bdf8;
    font-size: 20px;
    font-weight: 700;
    padding: 16px 12px;
}

/* Sidebar Navigation Buttons */
QWidget#sidebar QPushButton {
    background-color: transparent;
    color: #94a3b8;
    border: none;
    border-radius: 6px;
    text-align: left;
    padding: 10px 14px;
    margin: 2px 8px;
    font-weight: 500;
}

QWidget#sidebar QPushButton:hover {
    background-color: #1e293b;
    color: #f8fafc;
}

QWidget#sidebar QPushButton:checked {
    background-color: rgba(56, 189, 248, 0.15);
    color: #38bdf8;
    border-left: 3px solid #38bdf8;
    font-weight: 600;
}

/* === Inputs &amp; Dropdowns === */
QLineEdit, QComboBox {
    background-color: #1e293b;
    color: #f1f5f9;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 6px 10px;
    min-height: 20px;
}

QLineEdit:focus, QComboBox:focus {
    border: 1px solid #38bdf8;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox QAbstractItemView {
    background-color: #1e293b;
    color: #f1f5f9;
    selection-background-color: #0284c7;
    border: 1px solid #334155;
}

/* === Action Buttons (Content Area) === */
QStackedWidget#contenu QPushButton {
    background-color: #0284c7;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 7px 16px;
    font-weight: 600;
}

QStackedWidget#contenu QPushButton:hover {
    background-color: #0369a1;
}

QStackedWidget#contenu QPushButton:disabled {
    background-color: #334155;
    color: #64748b;
}

/* Destructive / Clear Button */
QPushButton#btnClear {
    background-color: rgba(239, 68, 68, 0.15);
    color: #f87171;
    border: 1px solid rgba(239, 68, 68, 0.4);
}

QPushButton#btnClear:hover {
    background-color: #dc2626;
    color: #ffffff;
}

/* === Alerts Table === */
QTableWidget {
    background-color: #111827;
    alternate-background-color: #162032;
    color: #e2e8f0;
    gridline-color: #1e293b;
    border: 1px solid #1e293b;
    border-radius: 8px;
    selection-background-color: rgba(56, 189, 248, 0.22);
    selection-color: #ffffff;
}

QTableWidget::item {
    padding: 6px 8px;
    border-bottom: 1px solid #1e293b;
}

QHeaderView::section {
    background-color: #1e293b;
    color: #94a3b8;
    font-weight: 700;
    font-size: 11px;
    text-transform: uppercase;
    padding: 8px;
    border: none;
    border-right: 1px solid #334155;
    border-bottom: 1px solid #334155;
}

/* === Status Bar === */
QStatusBar {
    background-color: #162032;
    color: #94a3b8;
    border-top: 1px solid #1e293b;
}</string>
