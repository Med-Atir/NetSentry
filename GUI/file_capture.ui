  <property name="styleSheet">
   <string notr="true">QWidget#FileForm {
    background-color: #0f172a;
    color: #e2e8f0;
    font-family: &quot;Inter&quot;, &quot;Segoe UI&quot;, sans-serif;
    font-size: 13px;
}

/* === Champ chemin du fichier PCAP === */
QLineEdit#pcapPath {
    background-color: #1e293b;
    color: #f1f5f9;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 6px 12px;
    min-height: 22px;
}

/* === Bouton Parcourir === */
QPushButton#browse {
    background-color: #1e293b;
    color: #e2e8f0;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 7px 16px;
    font-weight: 600;
}

QPushButton#browse:hover {
    background-color: #334155;
    border-color: #475569;
}

/* === Boutons Démarrer / Arrêter === */
QPushButton#startcap {
    background-color: #0284c7;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 7px 18px;
    font-weight: 600;
}

QPushButton#startcap:hover {
    background-color: #0369a1;
}

QPushButton#stopcap {
    background-color: rgba(239, 68, 68, 0.18);
    color: #f87171;
    border: 1px solid rgba(239, 68, 68, 0.45);
    border-radius: 6px;
    padding: 7px 18px;
    font-weight: 600;
}

QPushButton#stopcap:hover {
    background-color: #dc2626;
    color: #ffffff;
}

QPushButton:disabled {
    background-color: #1e293b;
    color: #64748b;
    border: 1px solid #334155;
}

/* === Compteurs === */
QLabel#label_1, QLabel#label_2, QLabel#label_4 {
    color: #94a3b8;
    font-size: 13px;
    font-weight: 500;
}

QLabel#packets, QLabel#flows, QLabel#alerts {
    color: #38bdf8;
    font-size: 16px;
    font-weight: 700;
    padding-left: 4px;
}

/* === Tableau des alertes === */
QTableWidget#tableAlerts {
    background-color: #111827;
    alternate-background-color: #162032;
    color: #e2e8f0;
    gridline-color: #1e293b;
    border: 1px solid #1e293b;
    border-radius: 8px;
    selection-background-color: rgba(56, 189, 248, 0.22);
    selection-color: #ffffff;
}

QTableWidget#tableAlerts::item {
    padding: 6px 8px;
    border-bottom: 1px solid #1e293b;
}

QHeaderView::section {
    background-color: #1e293b;
    color: #94a3b8;
    font-weight: 700;
    font-size: 11px;
    text-transform: uppercase;
    padding: 8px;
    border: none;
    border-right: 1px solid #334155;
    border-bottom: 1px solid #334155;
}</string>
